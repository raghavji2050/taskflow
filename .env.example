# Database (use a hosted MySQL provider for Vercel — e.g. Railway, TiDB Cloud, Aiven)
# Add ?connect_timeout=300 if you see connection timeouts in serverless.
DATABASE_URL="mysql://user:password@host:3306/todo_app"
# NextAuth (set NEXTAUTH_URL to your Vercel domain in production, e.g. https://your-app.vercel.app)
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"
# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email (optional - logs to console in dev without SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@taskflow.app"

# Push notifications (optional)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Cron job secret
CRON_SECRET="your-cron-secret"

# Sentry (optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
