# Database (use a hosted MySQL provider for Vercel — e.g. Railway, TiDB Cloud, Aiven)
# Prefer a small pool on shared/VPS MySQL to avoid "Too many connections".
# lib/prisma.ts caps connect_timeout and pool_timeout at 10s.
#   ?connection_limit=5&pool_timeout=10&connect_timeout=10
# URL-encode special chars in the password (e.g. ! → %21).
DATABASE_URL="mysql://user:password@host:3306/todo_app?connection_limit=5&pool_timeout=10&connect_timeout=10"
# NextAuth (set NEXTAUTH_URL to your Vercel domain in production, e.g. https://your-app.vercel.app)
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"
# Public site URL (used for SEO metadata / Open Graph in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# OAuth — Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (local):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (Vercel): https://YOUR-APP.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Legacy names also supported:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email — required for forgot-password / verification emails
# Mailtrap example:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your@gmail.com
#   SMTP_PASS=your-app-password
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Firebase Cloud Messaging (optional — web push via FCM)
# Console: https://console.firebase.google.com/ → Project settings
# Web app config + Cloud Messaging → Web Push certificates (VAPID key pair)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
# Service account (Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Paste private_key from the JSON; keep \n escapes or wrap in quotes
FIREBASE_PRIVATE_KEY=""

# Pusher Channels (realtime on Vercel — enable Client Events for typing)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Vercel Blob (required on Vercel for chat/task/document attachments)
# Create a store in Vercel → Storage → Blob, then add the read-write token here.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# Giphy (optional — chat GIF picker; https://developers.giphy.com/)
GIPHY_API_KEY=""

# Cron job secret. Set this in the Vercel project environment (Production, and
# Preview if preview crons should run). Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>` to /api/cron/*. Routes return 401 when
# the header is missing or wrong, including when this variable is unset.
# Generate a long random value; do not reuse NEXTAUTH_SECRET.
CRON_SECRET="your-cron-secret"

# Sentry (optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
