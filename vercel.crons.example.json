{
  "_note": "Vercel Cron requires a paid plan. When enabled, merge this crons array into vercel.json.",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/timer-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/scheduled-messages",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/trash",
      "schedule": "30 3 * * *"
    }
  ]
}
